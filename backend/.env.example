PORT=3001
# Optional. Defaults to backend/data/kasa.sqlite3 locally or /app/data/kasa.sqlite3 in production.
# Relative DB_PATH values are resolved from the backend directory.
NODE_ENV="production"
DB_PATH="/app/data/kasa.sqlite3"
JWT_SECRET=replace-with-a-long-random-server-only-secret
MESSAGING_SOCKET_SECRET=replace-with-another-long-random-server-only-secret
MESSAGING_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002
JWT_EXPIRES_IN="7d"
